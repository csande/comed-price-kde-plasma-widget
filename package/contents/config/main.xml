<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="graphHours" type="Int">
      <default>2</default>
      <label>Hours of price history shown in the time series chart</label>
      <min>1</min>
      <max>24</max>
    </entry>

    <!-- Index into ConfigGeneral.qml's chart-style ComboBox: 0 = Line,
         1 = Bar. Stored as a plain index (rather than a String) since a
         QQC2.ComboBox's currentText isn't directly settable, so a cfg_
         alias needs to target currentIndex instead (see
         contents/ui/ConfigGeneral.qml). -->
    <entry name="chartStyle" type="Int">
      <default>0</default>
      <label>Time series chart style: 0 = Line, 1 = Bar</label>
      <min>0</min>
      <max>1</max>
    </entry>

    <!-- Per-line-type appearance knobs for PriceGraph.qml's Canvas
         drawing. "Width" controls line thickness/density; "Alpha"
         controls opacity. Defaults match the values that were
         previously hardcoded in PriceGraph.qml. -->
    <entry name="dataLineWidth" type="Int">
      <default>2</default>
      <label>Width, in pixels, of the time series chart's data line (Line style only)</label>
      <min>1</min>
      <max>6</max>
    </entry>
    <entry name="dataLineAlpha" type="Double">
      <default>1.0</default>
      <label>Opacity of the time series chart's data line (Line style only)</label>
      <min>0.0</min>
      <max>1.0</max>
    </entry>
    <entry name="gridLineWidth" type="Int">
      <default>1</default>
      <label>Width, in pixels, of the faint horizontal gridlines drawn at each Y-axis tick</label>
      <min>1</min>
      <max>6</max>
    </entry>
    <entry name="gridLineAlpha" type="Double">
      <default>0.12</default>
      <label>Opacity of the faint horizontal gridlines drawn at each Y-axis tick</label>
      <min>0.0</min>
      <max>1.0</max>
    </entry>
    <entry name="zeroLineWidth" type="Int">
      <default>1</default>
      <label>Width, in pixels, of the zero line</label>
      <min>1</min>
      <max>6</max>
    </entry>
    <entry name="zeroLineAlpha" type="Double">
      <default>0.5</default>
      <label>Opacity of the zero line</label>
      <min>0.0</min>
      <max>1.0</max>
    </entry>

    <!-- Internal bookkeeping, not exposed in the config UI. Lets the
         widget redisplay the last known-good price immediately on
         Plasma startup, before the first fetch of a new session
         completes (see contents/ui/main.qml's restoreLastGoodState). -->
    <entry name="lastBand" type="String">
      <default>UNKNOWN</default>
    </entry>
    <entry name="lastGoodPriceText" type="String">
      <default></default>
    </entry>
    <entry name="lastGoodFeedTimestampMillis" type="LongLong">
      <default>0</default>
    </entry>
  </group>
</kcfg>
